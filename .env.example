# =============================================================================
# Zap Finanças — variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# =============================================================================

# -----------------------------------------------------------------------------
# App URL — usada para construir URLs de callback de autenticação.
# Em desenvolvimento: http://localhost:3000
# Em produção: https://zapfinancas.app
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=

# -----------------------------------------------------------------------------
# Supabase (obrigatório em produção)
# Onde achar: Supabase dashboard → Project Settings → API
# -----------------------------------------------------------------------------

# URL pública do projeto — usada no browser E no servidor.
NEXT_PUBLIC_SUPABASE_URL=

# Chave anon (segura para o browser) — permissões limitadas pelo RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave service_role — SERVER-ONLY. NUNCA exponha ao browser.
# Usada em webhooks, cron jobs e operações que precisam bypassar o RLS.
SUPABASE_SERVICE_ROLE_KEY=

# URL legada usada pela landing/waitlist (mantida por compatibilidade).
# Pode apontar para o mesmo valor de NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=

# -----------------------------------------------------------------------------
# Open Finance — provider
# OPENFINANCE_PROVIDER=mock (default) usa dados simulados e NÃO requer nada.
# OPENFINANCE_PROVIDER=pluggy ativa a integração real (exige as chaves abaixo).
# -----------------------------------------------------------------------------
OPENFINANCE_PROVIDER=mock

# Pluggy (apenas quando OPENFINANCE_PROVIDER=pluggy).
# Onde achar: app.pluggy.ai → Aplicações → Chaves de API
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Segredo p/ validar o webhook do Pluggy (HMAC-SHA256 do corpo bruto).
# Sem valor, o webhook aceita sem validar (apenas dev). Obrigatório em produção.
PLUGGY_WEBHOOK_SECRET=

# Segredo do cron de sincronização (GET /api/cron/sync exige
# Authorization: Bearer <CRON_SECRET>). O Vercel Cron envia esse header.
CRON_SECRET=

# -----------------------------------------------------------------------------
# WhatsApp
# WHATSAPP_PROVIDER=mock (default) não envia de verdade; =evolution usa a API real.
# -----------------------------------------------------------------------------
WHATSAPP_PROVIDER=mock

# Número público do Zap (exibido no app durante o pareamento). Ex: +55 11 99999-9999
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Segredo p/ validar o webhook inbound (header apikey ou Authorization Bearer).
# Sem valor, o webhook recusa em produção (fail closed).
WHATSAPP_WEBHOOK_SECRET=

# Evolution API (apenas quando WHATSAPP_PROVIDER=evolution).
EVOLUTION_API_URL=        # ex: https://evolution.seudominio.com
EVOLUTION_API_KEY=        # chave de API da instância
EVOLUTION_INSTANCE=       # nome da instância (ex: zapfinancas)

# -----------------------------------------------------------------------------
# IA — provider de categorização/Q&A
# AI_PROVIDER=mock (default sem chave) usa heurístico local, sem rede.
# AI_PROVIDER=gemini ativa o Google Gemini (free tier do Google AI Studio).
# Se GEMINI_API_KEY estiver preenchida e AI_PROVIDER não for setado, usa Gemini.
# -----------------------------------------------------------------------------
AI_PROVIDER=mock

# Google Gemini (server-only). Onde achar: aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Anthropic / Claude — reservado para Q&A financeiro avançado (fase futura).
# Onde achar: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=

# -----------------------------------------------------------------------------
# Pagamentos
# PAYMENTS_PROVIDER=mock (default) usa checkout simulado; =mercadopago usa o real.
# -----------------------------------------------------------------------------
PAYMENTS_PROVIDER=mock

# Mercado Pago (apenas quando PAYMENTS_PROVIDER=mercadopago).
# Onde achar: mercadopago.com.br → Credenciais → Produção
MERCADOPAGO_ACCESS_TOKEN=           # server-only
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY= # seguro para o browser
MERCADOPAGO_WEBHOOK_SECRET=         # para validar webhooks

# -----------------------------------------------------------------------------
# Pré-venda (Plano Fundador) — landing
# URL do checkout (Mercado Pago link de pagamento).
# Enquanto vazio, o botão captura apenas o email (lista de espera).
# -----------------------------------------------------------------------------
NEXT_PUBLIC_FOUNDER_CHECKOUT_URL=
